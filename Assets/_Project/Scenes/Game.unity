  m_text: "<b>KARANF\u0130L APT. Y\xD6NET\u0130M\u0130</b>\n<size=70%>KASIM 2023
    A\u0130DAT DURUMU</size>\n<size=62%>\nDaire 1 ........ \xF6dendi\nDaire 2 ........
