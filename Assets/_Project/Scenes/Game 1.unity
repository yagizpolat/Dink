  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e968036a0bcfe8e4997a0958d6de4a6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  enText: "\"If you\u2019re reading this note, it means you\u2019ve already realised
    I\u2019ve locked the doors. There\u2019s only one way to escape from here, but
    first you\u2019ll need to switch off the light. Don\u2019t forget, it can\u2019t
    see you in the dark, but it can hear you...\""
  trText: "\"E\u011Fer bu notu okuyorsan, kap\u0131lar\u0131 kilitledi\u011Fimi \xE7oktan
    anlam\u0131\u015Fs\u0131n demektir. Buradan ka\xE7man\u0131n tek bir yolu var
    ama \xF6nce \u0131\u015F\u0131\u011F\u0131 kapatman gerekecek. Unutma, o seni
    karanl\u0131kta g\xF6remiyor ama sesini duyabiliyor...\""
  deText: 
  frText: 
  esText: 
  ptText: 
  ruText: 
