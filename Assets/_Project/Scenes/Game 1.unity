  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"E\u011Fer bu notu okuyorsan, kap\u0131lar\u0131 kilitledi\u011Fimi \xE7oktan
    anlam\u0131\u015Fs\u0131n demektir. Buradan ka\xE7man\u0131n tek bir yolu var
    ama \xF6nce \u0131\u015F\u0131\u011F\u0131 kapatman gerekecek. Unutma, o seni
    karanl\u0131kta g\xF6remiyor ama sesini duyabiliyor...\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
